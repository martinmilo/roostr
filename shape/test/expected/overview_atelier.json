{
  "format": 1,
  "project": {
    "name": "Atelier",
    "stack": "Rails 8, PostgreSQL, Solid Queue",
    "description": "Sells places on a pottery studio's workshops and reminds the people who booked.",
    "watch_out": [
      "Stripe runs in test mode on staging; never use a real card there.",
      "The reminder job runs at 18:00 in the studio's time zone, not UTC, so a booking made later that evening for the next morning gets no reminder."
    ],
    "operations": [
      { "name": "start", "command": "bin/dev", "note": null },
      { "name": "test", "command": "bin/rails test", "note": null },
      { "name": "deploy", "command": "bin/kamal deploy", "note": "asks for the production vault password" }
    ],
    "environments": [
      { "name": "staging", "where": "staging.atelier.example (Hetzner)" },
      { "name": "production", "where": "atelier.example (Hetzner)" }
    ]
  },
  "processes": [
    {
      "id": "book-workshop",
      "name": "Book a place on a workshop",
      "description": "Reserve a place, take payment and confirm by email.",
      "group": "Bookings",
      "entrypoints": ["http POST /bookings", "mail BookingMailer#confirmation"],
      "files": [
        { "path": "app/models/booking.rb", "note": "holds the state machine" },
        { "path": "app/services/book_workshop.rb", "note": null }
      ],
      "try": "Open /workshops and pick a date with free places.\nBook with card 4242 4242 4242 4242 and any future expiry.\nCheck the confirmation mail in /letter_opener.\n",
      "outcomes": [
        {
          "name": "confirmed",
          "when": "payment succeeds",
          "then": "the booking is saved, the place count goes down and the confirmation mail is sent"
        },
        { "name": "full", "when": "no places left", "then": "booking refused, nothing saved" }
      ],
      "why": [
        "Payment is taken before the place is held so that abandoned checkouts never block a seat.",
        "Confirmation goes by mail rather than SMS because most bookings come from the studio's newsletter."
      ],
      "checked": null
    },
    {
      "id": "cancel-booking",
      "name": "Cancel a booking",
      "description": "Cancel a booking and free the place for the next person on the waiting list.",
      "group": "Bookings",
      "entrypoints": ["http DELETE /bookings/:id"],
      "files": [{ "path": "app/models/booking.rb", "note": null }],
      "try": null,
      "outcomes": [],
      "why": [],
      "checked": null
    },
    {
      "id": "remind-attendees",
      "name": "Remind attendees",
      "description": "Remind attendees the day before a workshop",
      "group": "Notifications",
      "entrypoints": ["job BookingReminderJob", "mail BookingMailer#reminder"],
      "files": [{ "path": "app/jobs/booking_reminder_job.rb", "note": null }],
      "try": "In a console, run BookingReminderJob.perform_now with a booking for tomorrow.",
      "outcomes": [],
      "why": [],
      "checked": null
    }
  ],
  "entrypoints": {
    "covers": ["http", "job", "mail"],
    "rows": [
      {
        "entrypoint": "http DELETE /bookings/:id", "kind": "http", "name": "DELETE /bookings/:id",
        "file": "app/controllers/bookings_controller.rb", "area": "Bookings", "processes": ["cancel-booking"]
      },
      {
        "entrypoint": "http GET /bookings/:id", "kind": "http", "name": "GET /bookings/:id",
        "file": "app/controllers/bookings_controller.rb", "area": "Bookings", "processes": []
      },
      {
        "entrypoint": "http GET /workshops", "kind": "http", "name": "GET /workshops",
        "file": "app/controllers/workshops_controller.rb", "area": "Workshops", "processes": []
      },
      {
        "entrypoint": "http POST /bookings", "kind": "http", "name": "POST /bookings",
        "file": "app/controllers/bookings_controller.rb", "area": "Bookings", "processes": ["book-workshop"]
      },
      {
        "entrypoint": "job BookingReminderJob", "kind": "job", "name": "BookingReminderJob",
        "file": "app/jobs/booking_reminder_job.rb", "area": "Notifications", "processes": ["remind-attendees"]
      },
      {
        "entrypoint": "mail BookingMailer#confirmation", "kind": "mail", "name": "BookingMailer#confirmation",
        "file": "app/mailers/booking_mailer.rb", "area": null, "processes": ["book-workshop"]
      },
      {
        "entrypoint": "mail BookingMailer#reminder", "kind": "mail", "name": "BookingMailer#reminder",
        "file": "app/mailers/booking_mailer.rb", "area": null, "processes": ["remind-attendees"]
      }
    ]
  },
  "needs_attention": null,
  "needs_checking": []
}
